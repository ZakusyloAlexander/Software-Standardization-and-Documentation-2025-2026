{
  "source": {
    "include": ["src"],
    "includePattern": ".+\\.(js|jsx)$",
    "exclude": ["node_modules", "**/*.stories.jsx", "src/pages"]
  },
  "opts": {
    "destination": "./public/docs",
    "recurse": true,
    "readme": "./README.md",
    "template": "node_modules/docdash"
  },
  "plugins": ["plugins/markdown"],
  "tags": {
    "allowUnknownTags": true
  },
  "templates": {
    "cleverLinks": true,
    "monospaceLinks": true
  }
}
